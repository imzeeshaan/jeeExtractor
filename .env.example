JEE_DATA_DIR=./data
JEE_DB_PATH=./data/app.db
JEE_RENDER_DPI=300
JEE_DB_ECHO=false

# Phase 5 vision providers: DeepSeek is the primary provider, OpenAI is the
# fallback (both hard-failure retry and validation-driven escalation).
# Only needed for the vision fallback path (scanned PDFs with no text
# layer, e.g. JEE Advanced) -- standard text-layer PDFs work without these.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# JEE_VISION_PROVIDER defaults to "mock" in src/config.py if unset (used by
# every automated test -- zero-cost, no API calls). Set to "real" here so a
# normal `cp .env.example .env` setup gets real DeepSeek/OpenAI transcription
# (the "Ask vision to transcribe" button in the Review Studio UI, and the
# vision-layout fallback path for scanned/JEE Advanced PDFs) out of the box
# -- requires the DEEPSEEK_API_KEY/OPENAI_API_KEY above to be filled in.
JEE_VISION_PROVIDER=real
# JEE_VISION_PRIMARY_MODEL=deepseek-flash
# JEE_VISION_FALLBACK_MODEL=gpt-5.6-luna
# JEE_VISION_CONCURRENCY=5
