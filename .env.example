JEE_DATA_DIR=./data
JEE_DB_PATH=./data/app.db
JEE_RENDER_DPI=300
JEE_DB_ECHO=false

# Phase 5 vision providers: DeepSeek is the primary provider, OpenAI is the
# fallback (both hard-failure retry and validation-driven escalation).
# Only needed for the vision fallback path (scanned PDFs with no text
# layer, e.g. JEE Advanced) -- standard text-layer PDFs work without these.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional overrides -- defaults are set in src/config.py if you leave these unset.
# JEE_VISION_PROVIDER=real
# JEE_VISION_PRIMARY_MODEL=deepseek-flash
# JEE_VISION_FALLBACK_MODEL=gpt-5.6-luna
# JEE_VISION_CONCURRENCY=5
